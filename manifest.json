{
  "name": "디마 다이렉트 - DIMA Direct",
  "version": "3.0.0",
  "description": "동아방송예술대학교 학생들이 자주 이용하는 웹사이트를 모아놓은 확장앱입니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
