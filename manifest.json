      "32": "assets/images/logo/dima-direct-icon-32.png",
      "48": "assets/images/logo/dima-direct-icon-48.png",
      "128": "assets/images/logo/dima-direct-icon-128.png"
    }
  },
  "options_page": "pages/options.html",
  "icons": {
    "16": "assets/images/logo/dima-direct-icon-16.png",
    "32": "assets/images/logo/dima-direct-icon-32.png",
    "48": "assets/images/logo/dima-direct-icon-48.png",
    "128": "assets/images/logo/dima-direct-icon-128.png"
  },
  "manifest_version": 3
